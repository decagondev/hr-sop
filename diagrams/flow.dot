digraph SOP {
  rankdir=TB;
  bgcolor="transparent";
  node [fontname="Helvetica"];
  edge [fontname="Helvetica", color="#94a3b8", fontcolor="#94a3b8"];
  labelloc="t"; label="Hire for an open role: requisition to signed contract"; fontcolor="#e5e7eb";
  "S1" [shape=box, style="filled", fillcolor="#1f2a37", color="#3b4b5e", penwidth=1, fontcolor="#e5e7eb", label="S1\nOpen and document the requisition"];
  "S2" [shape=diamond, style="rounded,filled", fillcolor="#1f2a37", color="#3b4b5e", penwidth=1, fontcolor="#e5e7eb", label="S2\nApprove headcount and budget"];
  "S3" [shape=box, style="rounded,filled", fillcolor="#1f2a37", color="#3b4b5e", penwidth=1, fontcolor="#e5e7eb", label="S3\nFinalize the job description and selection criteria"];
  "S4" [shape=box, style="filled", fillcolor="#1f2a37", color="#3b4b5e", penwidth=1, fontcolor="#e5e7eb", label="S4\nSource candidates"];
  "S5" [shape=box, style="filled", fillcolor="#1f2a37", color="#3b4b5e", penwidth=1, fontcolor="#e5e7eb", label="S5\nScreen applications"];
  "S6" [shape=box, style="rounded,filled", fillcolor="#1f2a37", color="#3b4b5e", penwidth=1, fontcolor="#e5e7eb", label="S6\nRecruiter phone screen"];
  "S7" [shape=box, style="filled", fillcolor="#1f2a37", color="#3b4b5e", penwidth=1, fontcolor="#e5e7eb", label="S7\nAdminister job-related assessments"];
  "S8" [shape=box, style="rounded,filled", fillcolor="#1f2a37", color="#3b4b5e", penwidth=1, fontcolor="#e5e7eb", label="S8\nConduct structured interviews"];
  "S9" [shape=diamond, style="rounded,filled", fillcolor="#1f2a37", color="#3b4b5e", penwidth=1, fontcolor="#e5e7eb", label="S9\nDebrief and make the selection decision"];
  "S10" [shape=box, style="rounded,filled", fillcolor="#1f2a37", color="#3b4b5e", penwidth=1, fontcolor="#e5e7eb", label="S10\nComplete reference checks"];
  "S11" [shape=box, style="rounded,filled", fillcolor="#1f2a37", color="#3b4b5e", penwidth=1, fontcolor="#e5e7eb", label="S11\nApprove compensation and extend a conditional verbal offer"];
  "S12" [shape=diamond, style="rounded,filled", fillcolor="#1f2a37", color="#3b4b5e", penwidth=1, fontcolor="#e5e7eb", label="S12\nCandidate response and negotiation"];
  "S13" [shape=box, style="filled", fillcolor="#1f2a37", color="#3b4b5e", penwidth=1, fontcolor="#e5e7eb", label="S13\nDisclose, authorize, and run the background check"];
  "S14" [shape=diamond, style="rounded,filled", fillcolor="#1f2a37", color="#3b4b5e", penwidth=1, fontcolor="#e5e7eb", label="S14\nAdjudicate the results"];
  "S15" [shape=diamond, style="rounded,filled", fillcolor="#1f2a37", color="#3b4b5e", penwidth=1, fontcolor="#e5e7eb", label="S15\nRun FCRA adverse action (only if withdrawing)"];
  "S16" [shape=box, style="filled", fillcolor="#1f2a37", color="#3b4b5e", penwidth=1, fontcolor="#e5e7eb", label="S16\nExtend the formal written offer"];
  "S17" [shape=box, style="rounded,filled", fillcolor="#1f2a37", color="#3b4b5e", penwidth=1, fontcolor="#e5e7eb", label="S17\nCountersign and execute the agreement"];
  "S18" [shape=box, style="filled", fillcolor="#1f2a37", color="#3b4b5e", penwidth=1, fontcolor="#e5e7eb", label="S18\nInitiate right-to-work and hand off to onboarding"];
  "S1" -> "S2";
  "S2" -> "S3" [label="Headcount and budget approved"];
  "S2" -> "S1" [label="Not approved — revise or defer"];
  "S3" -> "S4";
  "S4" -> "S5";
  "S5" -> "S6";
  "S6" -> "S7";
  "S7" -> "S8";
  "S8" -> "S9";
  "S9" -> "S10" [label="A suitable candidate is selected"];
  "S9" -> "S4" [label="No suitable candidate — re-open sourcing"];
  "S10" -> "S11";
  "S11" -> "S12";
  "S12" -> "S13" [label="Offer accepted"];
  "S12" -> "S11" [label="Counter-offer — re-approve and re-issue"];
  "S12" -> "S9" [label="Declined — revisit the shortlist"];
  "S13" -> "S14";
  "S14" -> "S16" [label="Clears — no disqualifying, job-related information"];
  "S14" -> "S15" [label="Potentially disqualifying information found"];
  "S15" -> "S16" [label="Dispute resolved in the candidate's favor or record corrected"];
  "S15" -> "S9" [label="Adverse action upheld — offer rescinded, revisit the shortlist"];
  "S16" -> "S17";
  "S17" -> "S18";
}
